# Gere valores próprios antes do primeiro deploy. Nunca versione o arquivo .env.
SECRET_KEY=substitua-por-uma-chave-aleatoria-longa
MASTERADM_KEY=substitua-por-uma-chave-mestra-diferente

# O caminho abaixo aponta para o volume persistente do container.
DATABASE_URL=sqlite:////app/agendamento/instance/local.db
